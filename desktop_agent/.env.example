# ── Desktop Trading-Bot Agent configuration ──────────────────────────────────
# Copy this file to ".env" and fill in your values, OR set these as real
# environment variables before running agent.py.

# Telegram bot token from @BotFather (create a NEW bot just for this — do not
# reuse your Family-Bot token).
DESKTOP_BOT_TOKEN=123456789:ABCdefYourTokenHere

# Comma-separated Telegram numeric user IDs allowed to control this machine.
# Message @userinfobot on Telegram to find your ID. REQUIRED — agent won't
# start if this is empty.
ALLOWED_USER_IDS=11111111

# Command used to launch your trading bot.
#   Windows example: python C:/trading/bot.py
#   macOS/Linux:     python3 /home/you/trading/bot.py
TRADING_BOT_CMD=python bot.py

# Path to the JSON status file your trading bot writes (see README).
STATUS_FILE=status.json

# Allow /run shell commands? 1 = yes, 0 = no.
ENABLE_SHELL=1

# Max seconds a /run command may run before being killed.
SHELL_TIMEOUT=30
